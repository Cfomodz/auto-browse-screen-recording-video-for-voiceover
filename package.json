{
  "name": "auto-browse-broll",
  "version": "0.1.0",
  "description": "Automated B-roll screen recording generator from voiceover transcripts",
  "main": "dist/index.js",
  "bin": {
    "auto-broll": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "npx vitest run",
    "test:unit": "npx vitest run tests/unit",
    "test:integration": "npx vitest run tests/integration",
    "test:watch": "npx vitest",
    "debug-audio": "ts-node scripts/debug-audio-devices.ts",
    "debug-typing-audio": "ts-node scripts/debug-typing-recorder-audio.ts"
  },
  "dependencies": {
    "bezier-easing": "^2.1.0",
    "commander": "^12.1.0",
    "dotenv": "^17.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.60.0",
    "puppeteer-core": "^23.0.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
